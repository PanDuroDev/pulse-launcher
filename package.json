{
  "name": "ps5-launcher",
  "productName": "Pulse Launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A PS5-style fullscreen game launcher for Windows",
  "author": "Pulse",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:check": "node scripts/design-census.mjs",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir --publish never && node scripts/verify-installer.mjs --unpacked",
    "dist": "npm run build && electron-builder --win nsis --publish never && node scripts/verify-installer.mjs",
    "verify:release": "node scripts/verify-installer.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@mingcute/react": "^3.0.2",
    "@noriginmedia/norigin-spatial-navigation-core": "^4.1.2",
    "@noriginmedia/norigin-spatial-navigation-react": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron-log": "^5.4.4",
    "motion": "^14.6.0",
    "music-metadata": "^12.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "uisfx": "^0.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.88.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
